{
    "compilerOptions": {
        "target": "esnext",
        "lib": ["es2023", "DOM"],
        "moduleDetection": "force",
        "module": "preserve",
        "moduleResolution": "bundler",
        "resolveJsonModule": true,
        "strict": false,
        "noUnusedLocals": true,
        "esModuleInterop": true,
        "isolatedModules": false,
        "verbatimModuleSyntax": true,
        "skipLibCheck": true,
        "jsx": "preserve",
        "jsxImportSource": "vue",
        "allowImportingTsExtensions": true,
        "noEmit": true
    },
    "include": [
        "tests/storybook",
        ".storybook",
        "src"
    ],
    "exclude": ["src/**/*.test.ts"]
}
