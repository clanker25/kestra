{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "composite": false,
    "declaration": true,
    "emitDeclarationOnly": false,
    "outDir": "./node_modules/.tmp/types",
    "tsBuildInfoFile": "./node_modules/.tmp/types/tsconfig.app.tsbuildinfo",
    "types": []
  },
  "references": [
    {"path": "./packages/design-system/tsconfig.app.json"}
  ],
  "include": [
    "src/**/*.ts",
    "src/**/*.tsx",
    "src/**/*.vue",
    "src/**/*.json",
  ],
  "exclude": [
    "src/**/*.spec.ts",
    "src/**/*.stories.ts",
    "src/**/*.stories.tsx"
  ]
}
